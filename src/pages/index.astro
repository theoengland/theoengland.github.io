---
// Every file in src/pages becomes a route. This one is "/".
// Add src/pages/talks.astro and you get "/talks".
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import { experience, other } from '../data/experience';

const email = 'theo.england@gmail.com';
const linkedin = 'https://www.linkedin.com/in/theo-england-16424b34/';
---

<Base
  title="Theo England — Head of Marketing, go-to-market for technology companies"
  description="Berlin-based Head of Marketing building go-to-market for technology companies."
>
  <main>
    <img class="portrait" src="theo-england.jpg" alt="Theo England" width="112" height="112" />
    <h1>Theo England</h1>
    <p class="lede">Your first-hire for building out your go-to-market strategy.</p>
    <p>
      I've run marketing at Aardling, Quix and Cucumber: building community-led GTM at
      Quix from seed through Series A, running marketing at Cucumber through its
      acquisition by SmartBear and building a consultancy and events business with
      Aardling.
    </p>
    <p class="muted">Based in Berlin.</p>

    <h2>Experience</h2>
    <Experience roles={experience} />

    <h2>Side projects &amp; early roles</h2>
    <Experience roles={other} compact />

    <h2>Contact</h2>
    <p>
      <a href={`mailto:${email}`}>{email}</a> ·
      <a href={linkedin}>LinkedIn</a>
    </p>
  </main>
</Base>
