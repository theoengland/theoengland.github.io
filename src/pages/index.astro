---
// Every file in src/pages becomes a route. This one is "/".
// Add src/pages/talks.astro and you get "/talks".
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import { experience } from '../data/experience';

const email = 'theo.england@gmail.com';
const linkedin = 'https://www.linkedin.com/in/theo-england-16424b34/';
const twitter = 'https://twitter.com/theo_england';
---

<Base
  title="Theo England — Marketing, community & events"
  description="Berlin-based marketer who builds communities, conferences and content for technical audiences."
>
  <main>
    <img class="portrait" src="theo.jpeg" alt="Theo England" width="112" height="112" />
    <h1>Theo England</h1>
    <p class="lede">
      I build marketing, communities and conferences for technical audiences, and I
      usually end up running most of the pieces myself: content, analytics, the website,
      speaker relations and the event on the day.
    </p>
    <p class="muted">Based in Berlin. Open to new roles.</p>

    <h2>Experience</h2>
    <Experience roles={experience} />

    <h2>Contact</h2>
    <p>
      <a href={`mailto:${email}`}>{email}</a> ·
      <a href={linkedin}>LinkedIn</a> ·
      <a href={twitter}>Twitter</a>
    </p>
  </main>
</Base>
