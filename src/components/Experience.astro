---
// A component: a reusable chunk of markup with its own scoped styles.
// It receives a list of roles and renders one entry per role.
// `compact` hides locations and bullet points (used for side projects).
import type { Role } from '../data/experience';

interface Props {
  roles: Role[];
  compact?: boolean;
}

const { roles, compact = false } = Astro.props;
---

<ol class:list={{ compact }}>
  {roles.map((role) => (
    <li>
      <div class="head">
        <strong>{role.url ? <a href={role.url}>{role.org}</a> : role.org}</strong>
        <span class="period">{role.period}</span>
      </div>
      <div class="title">
        {role.title}
        {!compact && role.location && <span class="location"> · {role.location}</span>}
      </div>
      {role.summary && <p>{role.summary}</p>}
      {!compact && role.highlights && (
        <ul>
          {role.highlights.map((h) => <li>{h}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  /* Styles in a component only apply to that component. */
  ol { list-style: none; padding: 0; margin: 0; }
  ol > li { margin-bottom: 2.25rem; }
  .compact > li { margin-bottom: 1.25rem; }
  .head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .period, .title { color: var(--muted); font-size: 0.925rem; }
  .title { margin-bottom: 0.4rem; }
  p { margin: 0; }
  ul { margin: 0.6rem 0 0; padding-left: 1.1rem; }
  ul li { margin-bottom: 0.35rem; }
  ul li::marker { color: var(--accent); }
</style>
